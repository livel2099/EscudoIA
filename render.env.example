# Copiar estas variables en Render > Web Service > Environment.
# Los datos DB_* salen de la sección Connect de tu PostgreSQL existente.
DB_HOST=<internal-hostname>
DB_PORT=5432
DB_NAME=<database-name>
DB_USERNAME=<database-user>
DB_PASSWORD=<database-password>

JWT_ACCESS_SECRET=<random-secret-of-at-least-32-bytes>
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
FREE_DAILY_SCAN_LIMIT=10
RATE_LIMIT_REQUESTS_PER_MINUTE=60

MP_PRODUCTION_MODE=false
MP_MOCK_MODE=false
MP_CHECKOUT_MODE=API
MP_TEST_ACCESS_TOKEN=<mercadopago-test-access-token>
MP_TEST_PUBLIC_KEY=<mercadopago-test-public-key>
MERCADOPAGO_WEBHOOK_SECRET=<mercadopago-webhook-secret>

ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<admin-password-minimum-12-characters>
